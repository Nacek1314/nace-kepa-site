---
// Service sheets (2026-11-26): one real HTML page per service at /sl/services/<id>/ (Slovenian) — the same site with the service's own title,
// description, link preview, structured data and static snapshot (content.js + settings.json), opening #s-<id> (svView() in app.js).
// English twin: src/pages/services/[id].astro. To remove: see the "Service sheets" note in src/site/Site.astro.
import Site from '../../../site/Site.astro';
import content from '../../../site/content.js?raw';
export function getStaticPaths() {
  const SERVICES: any[] = new Function(content + '\nreturn SERVICES;')();
  return SERVICES.filter((s) => /^[a-z0-9-]+$/.test(String(s.id))).map((s) => ({ params: { id: s.id } }));
}
const { id } = Astro.params;
---
<Site lang="sl" service={id} />
