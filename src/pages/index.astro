---
// The whole site is plain HTML/CSS/JS from src/site/, inlined into one page.
// PUBLIC_ORDER_ENDPOINT (repo variable, set in deploy.yml) is the Cloudflare Worker that emails/Telegrams orders.
import pageCss from '../site/page.css?raw';
import componentsCss from '../site/components.css?raw';
import drawings from '../site/drawings.js?raw';
import content from '../site/content.js?raw';
import app from '../site/app.js?raw';
import projects from '../data/projects.json';

const endpoint = (import.meta.env.PUBLIC_ORDER_ENDPOINT || '').trim();
const contactEmail = 'kepanace@gmail.com';
const projectsJs = 'window.NK_PROJECTS = ' + JSON.stringify(projects).replace(/</g, '\\u003c') + ';';
const script = [drawings, content, projectsJs, app.split('__ORDER_ENDPOINT__').join(endpoint || '__ORDER_ENDPOINT__').split('__CONTACT_EMAIL__').join(contactEmail)].join('\n');
const css = pageCss + '\n' + componentsCss;
const title = 'Nace Kepa · Engineering Studio';
const description = 'One-person engineering studio in Škofja Loka, Slovenia: SolidWorks CAD, 3D printing, ESP32 firmware and full custom builds — from the first sketch to the firmware.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://nacekepa.work/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#eef0ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131517" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://nacekepa.work/" />
    <meta property="og:image" content="https://nacekepa.work/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="nacekepa.work — From the first sketch to the firmware." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nacekepa.work/og.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" />
    <style is:inline set:html={css}></style>
  </head>
  <body>
    <div id="app">
      <noscript><p style="padding:24px;font-family:sans-serif">Nace Kepa · Engineering Studio — CAD, 3D printing, embedded systems and full custom builds in Škofja Loka. Enable JavaScript to browse the site, or email kepanace@gmail.com.</p></noscript>
    </div>
    <script is:inline set:html={script}></script>
    <script>
      // three.js (~600 KB) loads only when a project page with a 3D model is opened.
      let loading: Promise<unknown> | null = null;
      (window as any).NKViewerLoad = () => (loading ??= import('../site/viewer.js'));
      if (document.getElementById('viewer')) (window as any).NKViewerLoad();
    </script>
  </body>
</html>
