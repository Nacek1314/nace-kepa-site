---
// The whole site is plain HTML/CSS/JS from src/site/, inlined into one page. This component renders it twice:
// src/pages/index.astro (English, https://nacekepa.work/) and src/pages/sl/index.astro (Slovenian, /sl/) — same app,
// same script (same CSP hash); only the start language, <head> text, structured data and static snapshot differ.
// PUBLIC_ORDER_ENDPOINT (repo variable, set in deploy.yml) is the Cloudflare Worker that emails/Telegrams orders.
import pageCss from './page.css?raw';
import componentsCss from './components.css?raw';
import drawings from './drawings.js?raw';
import content from './content.js?raw';
import app from './app.js?raw';
import projects from '../data/projects.json';
import news from '../data/news.json';
import { createHash } from 'node:crypto';

// Landing pages (2026-11-01): the same site rendered once more per published project (/portfolio/<slug>/, /sl/portfolio/
// <slug>/) and news post (/news/<slug>/, /sl/news/<slug>/) — src/pages/portfolio/[slug].astro, src/pages/news/[slug].astro
// and their /sl/ twins pass `project` or `post`. Such a page has its own title, description, canonical, hreflang, link-preview
// tags, structured data and static snapshot (all from projects.json / news.json), and a <meta name="nk-start"> that tells
// app.js to open that sheet; the app then carries on as usual (its links move the address back to / or /sl/).
// To remove: delete those four page files, this block and the `landing`-conditional parts below, the START_VIEW lines in
// app.js and the landing entries in astro.config.mjs (sitemap filter + redirects).
const { lang = 'en', project = null, post = null } = Astro.props as { lang?: 'en' | 'sl'; project?: any; post?: any };
const SL = lang === 'sl';
const home = SL ? 'https://nacekepa.work/sl/' : 'https://nacekepa.work/';
const item: any = project || post;
const landing = item ? (SL ? '/sl' : '') + (project ? '/portfolio/' : '/news/') + item.slug + '/' : '';
const pageUrl = landing ? 'https://nacekepa.work' + landing : home; // canonical address of this page
const altEn = landing ? 'https://nacekepa.work' + landing.replace(/^\/sl/, '') : 'https://nacekepa.work/';
const altSl = landing ? 'https://nacekepa.work/sl' + landing.replace(/^\/sl/, '') : 'https://nacekepa.work/sl/';
const landingOf = (kind: 'p' | 'n', slug: string, sl = SL) => 'https://nacekepa.work' + (sl ? '/sl' : '') + (kind === 'p' ? '/portfolio/' : '/news/') + slug + '/';
const endpoint = (import.meta.env.PUBLIC_ORDER_ENDPOINT || '').trim();
const contactEmail = 'kepanace@gmail.com';
const projectsJs = 'window.NK_PROJECTS = ' + JSON.stringify(projects).replace(/</g, '\\u003c') + ';\nwindow.NK_NEWS = ' + JSON.stringify(news).replace(/</g, '\\u003c') + ';';
// Refuse to run inside another site's frame (clickjacking); GitHub Pages can't send X-Frame-Options.
const frameGuard = 'if (window.top !== window.self) { document.documentElement.style.display = "none"; try { window.top.location.replace(window.self.location.href); } catch (e) {} }';
let script = [frameGuard, drawings, content, projectsJs, app.split('__ORDER_ENDPOINT__').join(endpoint || '__ORDER_ENDPOINT__').split('__CONTACT_EMAIL__').join(contactEmail)].join('\n');
let css = pageCss + '\n' + componentsCss;
// Performance (2026-10-23): the inline script and styles are minified at build with esbuild, which Astro already ships
// (no new dependency). Only whitespace, comments and local names change — top-level names stay, so the app works the
// same. The CSP hash below is computed from the minified script, so it still matches. If esbuild is ever missing or
// fails, the page is built unminified exactly as before.
// The script and styles are the same on every page (home, /sl/ and the landing pages), so they are minified once per build.
const memo: any = ((globalThis as any).__nkMin ||= {});
try {
  const { transform } = await import('esbuild');
  if (memo.src !== script) { memo.src = script; memo.js = (await transform(script, { loader: 'js', minify: true, legalComments: 'none', charset: 'utf8' })).code.trim(); }
  if (memo.cssSrc !== css) { memo.cssSrc = css; memo.css = (await transform(css, { loader: 'css', minify: true, legalComments: 'none', charset: 'utf8' })).code.trim(); }
  script = memo.js; css = memo.css;
} catch (e) { console.warn('[Site.astro] minify skipped:', (e as Error).message); }
// Content-Security-Policy as a meta tag (GitHub Pages can't set headers): only this site's own scripts
// (the inline one is pinned by hash), only the order Worker and this origin for network requests.
const hash = (t: string) => "'sha256-" + createHash('sha256').update(t, 'utf8').digest('base64') + "'";
let workerOrigin = '';
try { workerOrigin = endpoint ? new URL(endpoint).origin : ''; } catch {}
const csp = [
  "default-src 'self'",
  `script-src 'self' ${hash(script)}`,
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "font-src 'self' https://fonts.gstatic.com",
  "img-src 'self' data: blob:",
  `connect-src 'self'${workerOrigin ? ' ' + workerOrigin : ''}`,
  "object-src 'none'",
  "frame-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "manifest-src 'self'",
  'upgrade-insecure-requests'
].join('; ');
const siteTitle = SL ? 'Nace Kepa · Inženirski studio' : 'Nace Kepa · Engineering Studio';
const siteDescription = SL
  ? 'Samostojni inženirski studio v Škofji Loki: CAD v SolidWorksu, 3D tisk, firmware za ESP32 in celotni izdelki po meri — od prve skice do firmwara.'
  : 'One-person engineering studio in Škofja Loka, Slovenia: SolidWorks CAD, 3D printing, ESP32 firmware and full custom builds — from the first sketch to the firmware.';
// Text in the page language for structured data and the snapshot (EN fallback when a field has no SL text).
const tl = (v: any) => (v && typeof v === 'object' ? v[lang] || v.en || '' : v || '');
const CATS: any = new Function(content + '\nreturn CATS;')();
const catName = (p: any) => (CATS[p.category] ? CATS[p.category][lang] : p.category);
const shown = (projects as any[]).filter((p) => !p.hidden);
const sheetNo = (p: any) => 'NK-' + String(p.year).slice(2) + '-' + String(shown.indexOf(p) + 1).padStart(2, '0'); // same as sheetNo() in app.js
// A landing page is titled and described by its sheet / post (same title as app.js gives the tab); the home pages keep the studio text.
const title = item ? tl(item.title) + ' · Nace Kepa' : siteTitle;
const description = project
  ? [tl(project.description), (SL ? 'List ' : 'Sheet ') + sheetNo(project) + ' · ' + catName(project) + ' · ' + project.year + (project.materials ? ' · ' + project.materials : '') + ' — Nace Kepa, ' + (SL ? 'inženirski studio, Škofja Loka.' : 'engineering studio, Škofja Loka.')].filter(Boolean).join(' ')
  : post ? (tl(post.summary) || siteDescription) : siteDescription;
const photoUrl = (ph: string) => 'https://nacekepa.work/' + String(ph).replace(/^\/+/, '').split('/').map(encodeURIComponent).join('/');
const ogImage = item && (item.photos || []).length ? photoUrl(item.photos[0]) : 'https://nacekepa.work/og.png';
// Links inside the snapshot and structured data point at this page (/ or /sl/) so each language stays on its own URL.
const at = (h: string) => (SL ? '/sl/' : '/') + h;
// Service names and descriptions come from SERVICES in content.js (same text as on #services), read at build time.
const services: any[] = new Function(content + '\nreturn SERVICES;')();
// Structured data for search engines (a data block, not executed, so the CSP script hash doesn't apply).
// Only facts already on the page: name, place, contact, services, LinkedIn.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: siteTitle,
  url: home,
  inLanguage: lang,
  image: 'https://nacekepa.work/og.png',
  logo: 'https://nacekepa.work/apple-touch-icon.png',
  description: siteDescription,
  email: 'mailto:' + contactEmail,
  // Contact package (2026-10-29): the same contact facts as the card on #about (e-mail, languages, EU).
  contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: contactEmail, url: home + '#contact', availableLanguage: ['sl', 'en'], areaServed: 'EU' },
  address: { '@type': 'PostalAddress', addressLocality: 'Škofja Loka', addressCountry: 'SI' },
  areaServed: 'EU',
  availableLanguage: ['sl', 'en'],
  founder: { '@type': 'Person', name: 'Nace Kepa', sameAs: ['https://www.linkedin.com/in/nace-kepa-82735038a'],
    hasCredential: ['Certified SolidWorks Associate', 'Certified SolidWorks Associate — Additive Manufacturing']
      .map((name) => ({ '@type': 'EducationalOccupationalCredential', name, credentialCategory: 'certification' })) },
  sameAs: ['https://www.linkedin.com/in/nace-kepa-82735038a'],
  knowsAbout: ['SolidWorks', 'CAD', '3D printing', 'ESP32', 'Embedded systems', 'IoT', 'Rapid prototyping', 'PLC programming', 'Siemens S7-1200', 'Beckhoff TwinCAT'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: SL ? 'Storitve' : 'Services',
    itemListElement: services.map((s: any) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: tl(s.title), description: tl(s.body), url: home + '#services', provider: { '@type': 'Person', name: 'Nace Kepa' } } }))
  }
}).replace(/</g, '\\u003c');
// One news post as BlogPosting and one project as CreativeWork (data blocks, not executed). Text, dates, years, categories
// and photos from news.json / projects.json. Each item's url is its landing page (2026-11-01), so search engines get one
// real address per sheet / post; the lists below and the landing pages share these.
const postLd = (n: any) => ({
  '@type': 'BlogPosting',
  headline: tl(n.title),
  description: tl(n.summary),
  datePublished: n.date,
  url: landingOf('n', n.slug),
  mainEntityOfPage: landingOf('n', n.slug),
  inLanguage: lang,
  image: (n.photos || []).length ? n.photos.map(photoUrl) : 'https://nacekepa.work/og.png',
  author: { '@type': 'Person', name: 'Nace Kepa', url: 'https://nacekepa.work/' },
  publisher: { '@type': 'Organization', name: 'Nace Kepa · Engineering Studio', logo: { '@type': 'ImageObject', url: 'https://nacekepa.work/apple-touch-icon.png' } }
});
const projectLd = (p: any) => ({
  '@type': 'CreativeWork',
  name: tl(p.title),
  alternateName: sheetNo(p),
  description: tl(p.description) || undefined,
  url: landingOf('p', p.slug),
  dateCreated: p.year ? String(p.year) : undefined,
  genre: p.category || undefined,
  keywords: p.materials || undefined,
  image: (p.photos || []).length ? p.photos.map(photoUrl) : undefined,
  inLanguage: lang,
  creator: { '@type': 'Person', name: 'Nace Kepa', url: 'https://nacekepa.work/' }
});
const posts = (news as any[]).filter((n) => !n.hidden);
// Home pages: all posts and the project list. Landing pages: the one item plus a breadcrumb (Home › Work / News › item).
const newsLd = !item && posts.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': posts.map(postLd) }).replace(/</g, '\\u003c') : '';
const projectsLd = !item && shown.length ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: (SL ? 'Projekti' : 'Projects') + ' · Nace Kepa',
  url: home + '#work',
  numberOfItems: shown.length,
  itemListElement: shown.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: projectLd(p) }))
}).replace(/</g, '\\u003c') : '';
const T: any = new Function(content + '\nreturn T;')();
const itemLd = item ? JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    Object.assign(project ? projectLd(project) : postLd(post), { mainEntityOfPage: pageUrl, isPartOf: { '@type': 'WebSite', name: siteTitle, url: home } }),
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Nace Kepa', item: home },
      { '@type': 'ListItem', position: 2, name: project ? T[lang].nav.work : T[lang].nav.news, item: home + (project ? '#work' : '#news') },
      { '@type': 'ListItem', position: 3, name: tl(item.title), item: pageUrl }
    ] }
  ]
}).replace(/</g, '\\u003c') : '';
// Static snapshot of the page for crawlers, link previews and visitors without JavaScript (SEO package, 2026-10-20).
// app.js replaces it on its first render, so normal visitors never see it. Only text already on the site (content.js,
// projects.json, news.json). Remove: this block, {snapshot} in #app and the ".ssr" rules at the end of page.css.
const ex = (v: any) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
// Same text rules as richText() in app.js, without links: blank line = paragraph, "- " lines = list, "1. " lines = numbered list.
const rich = (s: string) => String(s || '').split(/\n{2,}/).filter((b) => b.trim()).map((block) => {
  const lines = block.split('\n');
  if (lines.every((l) => /^\s*-\s+/.test(l))) return '<ul>' + lines.map((l) => '<li>' + ex(l.replace(/^\s*-\s+/, '')) + '</li>').join('') + '</ul>';
  if (lines.every((l) => /^\s*\d+[.)]\s+/.test(l))) return '<ol>' + lines.map((l) => '<li>' + ex(l.replace(/^\s*\d+[.)]\s+/, '')) + '</li>').join('') + '</ol>';
  return '<p>' + lines.map(ex).join('<br>') + '</p>';
}).join('');
const snapshot = (() => {
  const x = T[lang];
  // On a landing page the language link goes to the same sheet / post in the other language.
  const other = SL ? `<a href="${ex(landing ? altEn : '/')}" hreflang="en" lang="en">English</a>` : `<a href="${ex(landing ? altSl : '/sl/')}" hreflang="sl" lang="sl">Slovenščina</a>`;
  const header = `<div class="ssr" lang="${lang}"><header><p><a href="${at('')}">nacekepa.work</a> · ${ex(x.heroLabel)}</p><nav aria-label="${SL ? 'Razdelki' : 'Sections'}"><a href="${at('#services')}">${ex(x.nav.services)}</a> · <a href="${at('#work')}">${ex(x.nav.work)}</a> · <a href="${at('#news')}">${ex(x.nav.news)}</a> · <a href="${at('#about')}">${ex(x.nav.about)}</a> · <a href="${at('#order')}">${ex(x.cta)}</a> · ${other}</nav></header>`;
  const foot = `<p><a href="${at('#order')}">${ex(x.cta)}</a> · <a href="mailto:${contactEmail}">${contactEmail}</a> · <a href="https://www.linkedin.com/in/nace-kepa-82735038a">LinkedIn</a></p></main></div>`;
  if (project) {
    const p = project;
    const rows = [[x.pCategory, catName(p)], [x.pYear, String(p.year)]].concat(p.materials ? [[x.pMaterials, p.materials]] : []);
    const photos = (p.photos || []).map((ph: string, i: number) => `<img src="${ex('/' + String(ph).replace(/^\/+/, ''))}" alt="${ex(tl(p.title) + ' · ' + (i + 1))}" loading="lazy" decoding="async">`).join('');
    return header + `<main><p><a href="${at('#work')}">← ${ex(x.allWork)}</a></p><p>${ex(sheetNo(p))} · ${ex(catName(p))} · ${ex(p.year)}</p><h1>${ex(tl(p.title))}</h1><p>${ex(tl(p.description))}</p>` +
      `<dl>${rows.map((r) => `<dt>${ex(r[0])}</dt><dd>${ex(r[1])}</dd>`).join('')}</dl>${rich(tl(p.details))}${photos}` + foot;
  }
  if (post) {
    const n = post;
    const photos = (n.photos || []).map((ph: string, i: number) => `<img src="${ex('/' + String(ph).replace(/^\/+/, ''))}" alt="${ex(tl(n.title) + ' · ' + (i + 1))}" loading="lazy" decoding="async">`).join('');
    return header + `<main><p><a href="${at('#news')}">← ${ex(x.nav.news)}</a></p><h1>${ex(tl(n.title))}</h1><p><time datetime="${ex(n.date)}">${ex(n.date)}</time></p><p>${ex(tl(n.summary))}</p>${rich(tl(n.body))}${photos}` + foot;
  }
  const svc = services.map((s: any) => `<li><h3>${ex(s.code)} · ${ex(tl(s.title))}</h3><p>${ex(tl(s.body))}</p><p>${ex(x.turnaround)}: ${ex(s.time ? tl(s.time) : x.onRequest)}</p></li>`).join('');
  const work = shown.map((p) => `<li><a href="${ex(landingOf('p', p.slug))}">${ex(tl(p.title))}</a> — ${ex(catName(p))}, ${ex(p.year)}. ${ex(tl(p.description))}</li>`).join('');
  const posts2 = (news as any[]).filter((n) => !n.hidden && !n.draft).sort((a, b) => String(b.date).localeCompare(String(a.date)));
  const newsHtml = posts2.length ? `<h2>${ex(x.newsPageTitle)}</h2><ul>${posts2.map((n) => `<li><a href="${ex(landingOf('n', n.slug))}">${ex(tl(n.title))}</a> (<time datetime="${ex(n.date)}">${ex(n.date)}</time>) — ${ex(tl(n.summary))}</li>`).join('')}</ul>` : '';
  return header +
    `<main><h1>${ex(x.heroA)} ${ex(x.heroB)}${ex(x.heroEm)}</h1><p>${ex(x.heroLead)}</p>` +
    `<h2>${ex(x.servicesPageTitle)}</h2><p>${ex(x.servicesPageLead)}</p><ul>${svc}</ul>` +
    `<h2>${ex(x.nav.work)} · ${shown.length}</h2><ul>${work}</ul>${newsHtml}` +
    `<h2>${ex(x.nav.about)}</h2><p>${ex(x.aboutBody)}</p>` + foot;
})();
// Alt text of the link-preview image: the sheet / post title on a landing page with a photo, else the hero line.
const ogAlt = item && (item.photos || []).length ? tl(item.title) + ' — nacekepa.work' : 'nacekepa.work — ' + T[lang].heroA + ' ' + T[lang].heroB + T[lang].heroEm;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="sl" href={altSl} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
    {landing && <meta name="nk-start" content={(project ? 'p-' : 'n-') + item.slug} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/atom+xml" title="Nace Kepa · News (EN)" href="/news.xml" hreflang="en" />
    <link rel="alternate" type="application/atom+xml" title="Nace Kepa · Novice (SL)" href="/news-sl.xml" hreflang="sl" />
    <meta name="theme-color" content="#eef0ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131517" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={post ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content={SL ? 'sl_SI' : 'en_GB'} />
    <meta property="og:locale:alternate" content={SL ? 'en_GB' : 'sl_SI'} />
    <meta property="og:url" content={pageUrl} />
    {post && <meta property="article:published_time" content={post.date} />}
    <meta property="og:image" content={ogImage} />
    {ogImage.endsWith('/og.png') && <meta property="og:image:width" content="1200" />}
    {ogImage.endsWith('/og.png') && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" />
    <style is:inline set:html={css}></style>
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
    {newsLd && <script is:inline type="application/ld+json" set:html={newsLd}></script>}
    {projectsLd && <script is:inline type="application/ld+json" set:html={projectsLd}></script>}
    {itemLd && <script is:inline type="application/ld+json" set:html={itemLd}></script>}
  </head>
  <body>
    <div id="app">
      <Fragment set:html={snapshot} />
      {SL
        ? <noscript><p style="padding:24px;font-family:sans-serif">Nace Kepa · Inženirski studio — CAD, 3D tisk, vgrajeni sistemi in celotni izdelki po meri v Škofji Loki. Za brskanje po strani vklopite JavaScript ali pišite na kepanace@gmail.com.</p></noscript>
        : <noscript><p style="padding:24px;font-family:sans-serif">Nace Kepa · Engineering Studio — CAD, 3D printing, embedded systems and full custom builds in Škofja Loka. Enable JavaScript to browse the site, or email kepanace@gmail.com.</p></noscript>}
    </div>
    <script is:inline set:html={script}></script>
    <script>
      // three.js (~600 KB) loads only when a project page with a 3D model is opened.
      let loading: Promise<unknown> | null = null;
      (window as any).NKViewerLoad = () => (loading ??= import('./viewer.js'));
      if (document.getElementById('viewer')) (window as any).NKViewerLoad();
    </script>
  </body>
</html>
