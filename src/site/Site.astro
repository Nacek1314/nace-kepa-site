---
// The whole site is plain HTML/CSS/JS from src/site/, inlined into one page. This component renders it twice:
// src/pages/index.astro (English, https://nacekepa.work/) and src/pages/sl/index.astro (Slovenian, /sl/) — same app,
// same script (same CSP hash); only the start language, <head> text, structured data and static snapshot differ.
// PUBLIC_ORDER_ENDPOINT (repo variable, set in deploy.yml) is the Cloudflare Worker that emails/Telegrams orders.
import pageCss from './page.css?raw';
import componentsCss from './components.css?raw';
import drawings from './drawings.js?raw';
import qr from './qr.js?raw'; // QR package (2026-11-03): window.NK_QR — codes on sheets, posts, tools and the contact card
import content from './content.js?raw';
import app from './app.js?raw';
import prefs from './prefs.js?raw'; // Sheet settings (2026-11-21): applied in the <head>, before the page is drawn
import projects from '../data/projects.json';
import news from '../data/news.json';
import settings from '../data/settings.json'; // pricing, print parameters, promo, gift cards, FAQ — edited in /admin/ › Settings (2026-11-02)
import { createHash } from 'node:crypto';

// Landing pages (2026-11-01): the same site rendered once more per published project (/portfolio/<slug>/, /sl/portfolio/
// <slug>/) and news post (/news/<slug>/, /sl/news/<slug>/) — src/pages/portfolio/[slug].astro, src/pages/news/[slug].astro
// and their /sl/ twins pass `project` or `post`. Such a page has its own title, description, canonical, hreflang, link-preview
// tags, structured data and static snapshot (all from projects.json / news.json), and a <meta name="nk-start"> that tells
// app.js to open that sheet; the app then carries on as usual (its links move the address back to / or /sl/).
// To remove: delete those four page files, this block and the `landing`-conditional parts below, the START_VIEW lines in
// app.js and the landing entries in astro.config.mjs (sitemap filter + redirects).
const { lang = 'en', project = null, post = null, view = '', service = '' } = Astro.props as { lang?: 'en' | 'sl'; project?: any; post?: any; view?: string; service?: string }; // service: a service id = the service sheet page /services/<id>/ (2026-11-26) // view: 'news' = the /news/ index page (blog package, 2026-11-02); 'services' | 'work' | 'skills' | 'about' = section pages (2026-11-25)
const SL = lang === 'sl';
const home = SL ? 'https://nacekepa.work/sl/' : 'https://nacekepa.work/';
const item: any = project || post;
// Section pages (2026-11-25): /services/, /portfolio/, /skills/, /about/ (+ /sl/…) are real pages like /news/ — own title,
// description, link preview, breadcrumb and static snapshot, opening that section (src/pages/<section>/index.astro pass `view`).
// To remove: those eight page files, SECTIONS / `sec` here, sectionCard in src/og/, the paths in astro.config.mjs (put the redirects back).
const SECTIONS: Record<string, string> = { news: '/news/', services: '/services/', work: '/portfolio/', skills: '/skills/', about: '/about/', glossary: '/glossary/' }; // glossary: Glossary NK-G (2026-11-27)
const sec = !item && !service && SECTIONS[view] ? view : '';
const secUrl = (v: string, sl = SL) => 'https://nacekepa.work' + (sl ? '/sl' : '') + SECTIONS[v];
const landing = service ? (SL ? '/sl' : '') + '/services/' + service + '/' : item ? (SL ? '/sl' : '') + (project ? '/portfolio/' : '/news/') + item.slug + '/' : sec ? (SL ? '/sl' : '') + SECTIONS[sec] : '';
const startView = service ? 's-' + service : project ? 'p-' + project.slug : post ? 'n-' + post.slug : view;
const pageUrl = landing ? 'https://nacekepa.work' + landing : home; // canonical address of this page
const altEn = landing ? 'https://nacekepa.work' + landing.replace(/^\/sl/, '') : 'https://nacekepa.work/';
const altSl = landing ? 'https://nacekepa.work/sl' + landing.replace(/^\/sl/, '') : 'https://nacekepa.work/sl/';
const landingOf = (kind: 'p' | 'n', slug: string, sl = SL) => 'https://nacekepa.work' + (sl ? '/sl' : '') + (kind === 'p' ? '/portfolio/' : '/news/') + slug + '/';
const endpoint = (import.meta.env.PUBLIC_ORDER_ENDPOINT || '').trim();
const contactEmail = 'kepanace@gmail.com';
const projectsJs = 'window.NK_PROJECTS = ' + JSON.stringify(projects).replace(/</g, '\\u003c') + ';\nwindow.NK_NEWS = ' + JSON.stringify(news).replace(/</g, '\\u003c') + ';\nwindow.NK_SETTINGS = ' + JSON.stringify(settings).replace(/</g, '\\u003c') + ';';
// Refuse to run inside another site's frame (clickjacking); GitHub Pages can't send X-Frame-Options.
const frameGuard = 'if (window.top !== window.self) { document.documentElement.style.display = "none"; try { window.top.location.replace(window.self.location.href); } catch (e) {} }';
let script = [frameGuard, drawings, qr, content, projectsJs, app.split('__ORDER_ENDPOINT__').join(endpoint || '__ORDER_ENDPOINT__').split('__CONTACT_EMAIL__').join(contactEmail)].join('\n');
let css = pageCss + '\n' + componentsCss;
// Performance (2026-10-23): the inline script and styles are minified at build with esbuild, which Astro already ships
// (no new dependency). Only whitespace, comments and local names change — top-level names stay, so the app works the
// same. The CSP hash below is computed from the minified script, so it still matches. If esbuild is ever missing or
// fails, the page is built unminified exactly as before.
// The script and styles are the same on every page (home, /sl/ and the landing pages), so they are minified once per build.
const memo: any = ((globalThis as any).__nkMin ||= {});
try {
  const { transform } = await import('esbuild');
  if (memo.src !== script) { memo.src = script; memo.js = (await transform(script, { loader: 'js', minify: true, legalComments: 'none', charset: 'utf8' })).code.trim(); }
  if (memo.cssSrc !== css) { memo.cssSrc = css; memo.css = (await transform(css, { loader: 'css', minify: true, legalComments: 'none', charset: 'utf8' })).code.trim(); }
  script = memo.js; css = memo.css;
} catch (e) { console.warn('[Site.astro] minify skipped:', (e as Error).message); }
// Content-Security-Policy as a meta tag (GitHub Pages can't set headers): only this site's own scripts
// (the inline one is pinned by hash), only the order Worker and this origin for network requests.
const hash = (t: string) => "'sha256-" + createHash('sha256').update(t, 'utf8').digest('base64') + "'";
let workerOrigin = '';
try { workerOrigin = endpoint ? new URL(endpoint).origin : ''; } catch {}
const csp = [
  "default-src 'self'",
  `script-src 'self' ${hash(prefs)} ${hash(script)}`, // the app + the small Sheet settings reader in the <head>, each pinned by its hash
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "font-src 'self' https://fonts.gstatic.com",
  "img-src 'self' data: blob:",
  `connect-src 'self'${workerOrigin ? ' ' + workerOrigin : ''}`,
  "object-src 'none'",
  "frame-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "manifest-src 'self'",
  'upgrade-insecure-requests'
].join('; ');
const siteTitle = SL ? 'Nace Kepa · Inženirski studio' : 'Nace Kepa · Engineering Studio';
const siteDescription = SL
  ? 'Samostojni inženirski studio v Škofji Loki: CAD v SolidWorksu, 3D tisk, firmware za ESP32 in celotni izdelki po meri — od prve skice do firmwara.'
  : 'One-person engineering studio in Škofja Loka, Slovenia: SolidWorks CAD, 3D printing, ESP32 firmware and full custom builds — from the first sketch to the firmware.';
// Text in the page language for structured data and the snapshot (EN fallback when a field has no SL text).
const tl = (v: any) => (v && typeof v === 'object' ? v[lang] || v.en || '' : v || '');
const CATS: any = new Function(content + '\nreturn CATS;')();
const catName = (p: any) => (CATS[p.category] ? CATS[p.category][lang] : p.category);
const shown = (projects as any[]).filter((p) => !p.hidden);
const sheetNo = (p: any) => 'NK-' + String(p.year).slice(2) + '-' + String(shown.indexOf(p) + 1).padStart(2, '0'); // same as sheetNo() in app.js
// A landing page is titled and described by its sheet / post (same title as app.js gives the tab); the home pages keep the studio text.
const T: any = new Function(content + '\nreturn T;')();
const SKILLS: any[] = new Function(content + '\nreturn SKILLS;')();
const GLOSSARY: any[] = new Function(content + '\nreturn typeof GLOSSARY === "undefined" ? [] : GLOSSARY;')(); // Glossary NK-G (2026-11-27)
const glNote = (g: any) => (g.m && T[lang].mp && T[lang].mp.notes && T[lang].mp.notes[g.m] ? ' ' + T[lang].mp.notes[g.m] : ''); // a material also carries the material picker's note, as on #glossary
const catCount = Object.keys(CATS).map((c) => [CATS[c][lang], shown.filter((p) => p.category === c).length] as [string, number]).filter((c) => c[1]);
const secTitle: Record<string, string> = SL ? {
  news: 'Novice · Nace Kepa',
  services: 'Storitve: CAD, 3D tisk, firmware, izdelki po meri · Nace Kepa',
  work: 'Projekti: vsi listi (' + shown.length + ') · Nace Kepa',
  skills: T.sl.skillsPageTitle + ' · Nace Kepa',
  about: T.sl.nav.about + ' · Nace Kepa, inženirski studio, Škofja Loka',
  glossary: 'Slovar: STEP, STL, FDM, PETG, firmware … po domače · Nace Kepa'
} : {
  news: 'News · Nace Kepa',
  services: 'Services: CAD, 3D printing, firmware, custom builds · Nace Kepa',
  work: 'Work: all project sheets (' + shown.length + ') · Nace Kepa',
  skills: T.en.skillsPageTitle + ' · Nace Kepa',
  about: T.en.nav.about + ' · Nace Kepa, engineering studio, Škofja Loka',
  glossary: 'Glossary: STEP, STL, FDM, PETG, firmware … in plain language · Nace Kepa'
};
const secDesc: Record<string, string> = SL ? {
  news: 'Novice iz delavnice Naceta Kepe: novi stroji, materiali in zaključeni projekti.',
  services: 'CAD v SolidWorksu, FDM 3D tisk, firmware za ESP32 in celotni izdelki po meri v Škofji Loki — roki in kaj dobite pri vsaki storitvi.',
  work: T.sl.workPageLead.replace(/\s*Filtrirajte.*$/, '') + ' ' + catCount.map((c) => c[0] + ' (' + c[1] + ')').join(', ') + ' — Nace Kepa, inženirski studio, Škofja Loka.',
  skills: T.sl.skillsPageLead.replace(/\.$/, '') + ': ' + SKILLS.map((g) => g.sl).join(', ') + '.',
  about: T.sl.aboutTitle + '. ' + String(T.sl.aboutBody).split(/(?<=\.)\s/)[0],
  glossary: GLOSSARY.length + ' izrazov iz CAD-a, 3D tiska, materialov in elektronike, razloženih v stavku ali dveh: ' + GLOSSARY.slice(0, 6).map((g) => tl(g.t)).join(', ') + ' … — Nace Kepa, inženirski studio, Škofja Loka.'
} : {
  news: 'News from Nace Kepa\'s workshop: new machines, materials and finished jobs.',
  services: 'SolidWorks CAD, FDM 3D printing, ESP32 firmware and full custom builds in Škofja Loka, Slovenia — turnarounds and what you get with each service.',
  work: T.en.workPageLead.replace(/\s*Filter.*$/, '') + ' ' + catCount.map((c) => c[0] + ' (' + c[1] + ')').join(', ') + ' — Nace Kepa, engineering studio, Škofja Loka.',
  skills: T.en.skillsPageLead.replace(/\.$/, '') + ': ' + SKILLS.map((g) => g.en).join(', ') + '.',
  about: T.en.aboutTitle + '. ' + String(T.en.aboutBody).split(/(?<=\.)\s/)[0],
  glossary: GLOSSARY.length + ' CAD, 3D printing, material and electronics terms explained in a sentence or two: ' + GLOSSARY.slice(0, 6).map((g) => tl(g.t)).join(', ') + ' … — Nace Kepa, engineering studio, Škofja Loka.'
};
let title = item ? tl(item.title) + ' · Nace Kepa' : sec ? secTitle[sec] : siteTitle;
let description = project
  ? [tl(project.description), (SL ? 'List ' : 'Sheet ') + sheetNo(project) + ' · ' + catName(project) + ' · ' + project.year + (project.materials ? ' · ' + project.materials : '') + ' — Nace Kepa, ' + (SL ? 'inženirski studio, Škofja Loka.' : 'engineering studio, Škofja Loka.')].filter(Boolean).join(' ')
  : post ? (tl(post.summary) || siteDescription) : sec ? secDesc[sec] : siteDescription;
const photoUrl = (ph: string) => 'https://nacekepa.work/' + String(ph).replace(/^\/+/, '').split('/').map(encodeURIComponent).join('/');
// Link-preview image (SEO package, 2026-11-02): a landing page gets its own drawn card from /og/… (src/og/card.ts, built per
// language); the home pages keep /og.png. A sheet with photos still shows its first photo (a real part beats a drawing).
const ogCard = landing ? 'https://nacekepa.work/og' + landing.replace(/\/$/, '') + '.png' : '';
const ogImage = item && (item.photos || []).length ? photoUrl(item.photos[0]) : ogCard || 'https://nacekepa.work/og.png';
const ogSized = ogImage.endsWith('/og.png') || ogImage === ogCard; // 1200×630 for /og.png and every drawn card
// Links inside the snapshot and structured data point at this page (/ or /sl/) so each language stays on its own URL.
const at = (h: string) => (SL ? '/sl/' : '/') + h;
// Service names and descriptions come from SERVICES in content.js (same text as on #services), read at build time.
const services: any[] = new Function(content + '\nreturn SERVICES;')();
// Services overrides from settings.json (admin › Settings › Services), same rule as in app.js: a filled value replaces the built-in text.
(() => { const ov: any = (settings as any).services || {}; services.forEach((s: any) => { const o = ov[s.key]; if (!o) return;
  if (o.time && (o.time.en || o.time.sl)) s.time = { en: o.time.en || o.time.sl, sl: o.time.sl || o.time.en };
  ['need', 'get'].forEach((k) => { if (o[k]) ['en', 'sl'].forEach((l) => { const alt = l === 'en' ? 'sl' : 'en'; if (Array.isArray(o[k][l]) && o[k][l].length) s[k][l] = o[k][l]; else if (Array.isArray(o[k][alt]) && o[k][alt].length) s[k][l] = o[k][alt]; }); }); }); })();
// Service sheets (2026-11-26): /services/<id>/ (+ /sl/…) — one real page per service with its own title, description, link preview,
// Service + breadcrumb structured data and snapshot, opening #s-<id> (svView() in app.js). Only text and numbers from content.js /
// settings.json. To remove: src/pages/services/[id].astro (+ /sl/), every `svc` / `service` part of this file, serviceCard in src/og/card.ts.
const svc: any = service ? services.find((s: any) => s.id === service) : null;
const svcUrl = (s: any, sl = SL) => 'https://nacekepa.work' + (sl ? '/sl' : '') + '/services/' + s.id + '/';
if (svc) {
  title = tl(svc.title) + ' · Nace Kepa, ' + (SL ? 'inženirski studio, Škofja Loka' : 'engineering studio, Škofja Loka');
  description = tl(svc.body) + ' ' + T[lang].turnaround + ': ' + (svc.time ? tl(svc.time) : T[lang].onRequest) + '. Nace Kepa, ' + (SL ? 'inženirski studio, Škofja Loka.' : 'engineering studio, Škofja Loka.');
}
// Structured data for search engines (a data block, not executed, so the CSP script hash doesn't apply).
// Only facts already on the page: name, place, contact, services, LinkedIn.
// No published rates (Nace, 2026-11-27): the service offers carry no priceSpecification.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: siteTitle,
  url: home,
  inLanguage: lang,
  image: 'https://nacekepa.work/og.png',
  logo: 'https://nacekepa.work/apple-touch-icon.png',
  description: siteDescription,
  email: 'mailto:' + contactEmail,
  // Contact package (2026-10-29): the same contact facts as the card on #about (e-mail, languages, EU).
  contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: contactEmail, url: home + '#contact', availableLanguage: ['sl', 'en'], areaServed: 'EU' },
  address: { '@type': 'PostalAddress', addressLocality: 'Škofja Loka', addressCountry: 'SI' },
  areaServed: 'EU',
  availableLanguage: ['sl', 'en'],
  founder: { '@type': 'Person', name: 'Nace Kepa', sameAs: ['https://www.linkedin.com/in/nace-kepa-82735038a'],
    hasCredential: ['Certified SolidWorks Associate', 'Certified SolidWorks Associate — Additive Manufacturing']
      .map((name) => ({ '@type': 'EducationalOccupationalCredential', name, credentialCategory: 'certification' })) },
  sameAs: ['https://www.linkedin.com/in/nace-kepa-82735038a'].concat((settings as any).links && (settings as any).links.gbp ? [(settings as any).links.gbp] : []), // + Google Business Profile once set in admin › Settings
  knowsAbout: ['SolidWorks', 'CAD', '3D printing', 'ESP32', 'Embedded systems', 'IoT', 'Rapid prototyping', 'PLC programming', 'Siemens S7-1200', 'Beckhoff TwinCAT'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: SL ? 'Storitve' : 'Services',
    itemListElement: services.map((s: any) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: tl(s.title), description: tl(s.body), url: svcUrl(s), provider: { '@type': 'Person', name: 'Nace Kepa' } } }))
  }
}).replace(/</g, '\\u003c');
// One news post as BlogPosting and one project as CreativeWork (data blocks, not executed). Text, dates, years, categories
// and photos from news.json / projects.json. Each item's url is its landing page (2026-11-01), so search engines get one
// real address per sheet / post; the lists below and the landing pages share these.
const postLd = (n: any) => ({
  '@type': 'BlogPosting',
  headline: tl(n.title),
  description: tl(n.summary),
  datePublished: n.date,
  url: landingOf('n', n.slug),
  mainEntityOfPage: landingOf('n', n.slug),
  inLanguage: lang,
  image: (n.photos || []).length ? n.photos.map(photoUrl) : 'https://nacekepa.work/og' + (SL ? '/sl' : '') + '/news/' + n.slug + '.png', // the drawn card (src/og/card.ts)
  author: { '@type': 'Person', name: 'Nace Kepa', url: 'https://nacekepa.work/' },
  publisher: { '@type': 'Organization', name: 'Nace Kepa · Engineering Studio', logo: { '@type': 'ImageObject', url: 'https://nacekepa.work/apple-touch-icon.png' } }
});
const projectLd = (p: any) => ({
  '@type': 'CreativeWork',
  name: tl(p.title),
  alternateName: sheetNo(p),
  description: tl(p.description) || undefined,
  url: landingOf('p', p.slug),
  dateCreated: p.year ? String(p.year) : undefined,
  genre: p.category || undefined,
  keywords: p.materials || undefined,
  image: (p.photos || []).length ? p.photos.map(photoUrl) : 'https://nacekepa.work/og' + (SL ? '/sl' : '') + '/portfolio/' + p.slug + '.png', // the drawn card (src/og/card.ts)
  inLanguage: lang,
  creator: { '@type': 'Person', name: 'Nace Kepa', url: 'https://nacekepa.work/' }
});
const TODAY = new Date().toISOString().slice(0, 10); // a post dated after the build day is scheduled (blog package, 2026-11-02)
const posts = (news as any[]).filter((n) => !n.hidden && !(n.date && n.date > TODAY));
// Home pages: all posts and the project list. Landing pages: the one item plus a breadcrumb (Home › Work / News › item).
const newsLd = !item && (!sec || sec === 'news') && posts.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': posts.map(postLd) }).replace(/</g, '\\u003c') : '';
const projectsLd = !item && (!sec || sec === 'work') && shown.length ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: (SL ? 'Projekti' : 'Projects') + ' · Nace Kepa',
  url: secUrl('work'),
  numberOfItems: shown.length,
  itemListElement: shown.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: projectLd(p) }))
}).replace(/</g, '\\u003c') : '';
// FAQ from settings.json as FAQPage (home pages only; the same questions render as <details> on #services).
const faqs = ((settings as any).faq || []).filter((f: any) => f && f.q && f.a && tl(f.q) && tl(f.a));
const faqLd = !item && !sec && faqs.length ? JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f: any) => ({ '@type': 'Question', name: tl(f.q), acceptedAnswer: { '@type': 'Answer', text: tl(f.a) } })) }).replace(/</g, '\\u003c') : '';
const itemLd = item ? JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    Object.assign(project ? projectLd(project) : postLd(post), { mainEntityOfPage: pageUrl, isPartOf: { '@type': 'WebSite', name: siteTitle, url: home } }),
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Nace Kepa', item: home },
      { '@type': 'ListItem', position: 2, name: project ? T[lang].nav.work : T[lang].nav.news, item: secUrl(project ? 'work' : 'news') },
      { '@type': 'ListItem', position: 3, name: tl(item.title), item: pageUrl }
    ] }
  ]
}).replace(/</g, '\\u003c') : svc ? JSON.stringify({ '@context': 'https://schema.org', '@graph': [
  { '@type': 'Service', name: tl(svc.title), serviceType: tl(svc.title), description: tl(svc.body), url: pageUrl, mainEntityOfPage: pageUrl, inLanguage: lang, areaServed: 'EU',
    provider: { '@type': 'ProfessionalService', name: siteTitle, url: home }, offers: { '@type': 'Offer', url: pageUrl } },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Nace Kepa', item: home },
    { '@type': 'ListItem', position: 2, name: T[lang].nav.services, item: secUrl('services') },
    { '@type': 'ListItem', position: 3, name: tl(svc.title), item: pageUrl }
  ] }
] }).replace(/</g, '\\u003c') : sec === 'glossary' ? JSON.stringify({ '@context': 'https://schema.org', '@graph': [ // Glossary NK-G (2026-11-27)
  { '@type': 'DefinedTermSet', '@id': pageUrl, name: T[lang].gl.title, description: T[lang].gl.lead, url: pageUrl, inLanguage: lang,
    hasDefinedTerm: GLOSSARY.map((g) => ({ '@type': 'DefinedTerm', name: tl(g.t), alternateName: g.aka && g.aka.length ? g.aka : undefined, description: tl(g.d) + glNote(g), termCode: g.id, url: pageUrl + '#gl-' + g.id, inDefinedTermSet: pageUrl })) },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Nace Kepa', item: home },
    { '@type': 'ListItem', position: 2, name: T[lang].nav.glossary, item: pageUrl }
  ] }
] }).replace(/</g, '\\u003c') : sec ? JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Nace Kepa', item: home },
  { '@type': 'ListItem', position: 2, name: T[lang].nav[sec], item: pageUrl }
] }).replace(/</g, '\\u003c') : '';
// Static snapshot of the page for crawlers, link previews and visitors without JavaScript (SEO package, 2026-10-20).
// app.js replaces it on its first render, so normal visitors never see it. Only text already on the site (content.js,
// projects.json, news.json). Remove: this block, {snapshot} in #app and the ".ssr" rules at the end of page.css.
const ex = (v: any) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
// Same text rules as richText() in app.js, without links: blank line = paragraph, "- " lines = list, "1. " lines = numbered list.
const rich = (s: string) => String(s || '').split(/\n{2,}/).filter((b) => b.trim()).map((block) => {
  const lines = block.split('\n');
  if (lines.every((l) => /^\s*-\s+/.test(l))) return '<ul>' + lines.map((l) => '<li>' + ex(l.replace(/^\s*-\s+/, '')) + '</li>').join('') + '</ul>';
  if (lines.every((l) => /^\s*\d+[.)]\s+/.test(l))) return '<ol>' + lines.map((l) => '<li>' + ex(l.replace(/^\s*\d+[.)]\s+/, '')) + '</li>').join('') + '</ol>';
  return '<p>' + lines.map(ex).join('<br>') + '</p>';
}).join('');
const snapshot = (() => {
  const x = T[lang];
  // On a landing page the language link goes to the same sheet / post in the other language.
  const other = SL ? `<a href="${ex(landing ? altEn : '/')}" hreflang="en" lang="en">English</a>` : `<a href="${ex(landing ? altSl : '/sl/')}" hreflang="sl" lang="sl">Slovenščina</a>`;
  const header = `<div class="ssr" lang="${lang}"><header><p><a href="${at('')}">nacekepa.work</a> · ${ex(x.heroLabel)}</p><nav aria-label="${SL ? 'Razdelki' : 'Sections'}"><a href="${secUrl('services')}">${ex(x.nav.services)}</a> · <a href="${secUrl('work')}">${ex(x.nav.work)}</a> · <a href="${secUrl('news')}">${ex(x.nav.news)}</a> · <a href="${secUrl('skills')}">${ex(x.nav.skills)}</a> · <a href="${secUrl('about')}">${ex(x.nav.about)}</a> · <a href="${at('#order')}">${ex(x.cta)}</a> · ${other}</nav></header>`;
  const foot = `<p><a href="${at('#order')}">${ex(x.cta)}</a> · <a href="mailto:${contactEmail}">${contactEmail}</a> · <a href="https://www.linkedin.com/in/nace-kepa-82735038a">LinkedIn</a>${GLOSSARY.length ? ` · <a href="${secUrl('glossary')}">${ex(x.nav.glossary)}</a>` : ''}</p></main></div>`;
  if (project) {
    const p = project;
    const rows = [[x.pCategory, catName(p)], [x.pYear, String(p.year)]].concat(p.materials ? [[x.pMaterials, p.materials]] : []);
    const photos = (p.photos || []).map((ph: string, i: number) => `<img src="${ex('/' + String(ph).replace(/^\/+/, ''))}" alt="${ex(tl(p.title) + ' · ' + (i + 1))}" loading="lazy" decoding="async">`).join('');
    return header + `<main><p><a href="${secUrl('work')}">← ${ex(x.allWork)}</a></p><p>${ex(sheetNo(p))} · ${ex(catName(p))} · ${ex(p.year)}</p><h1>${ex(tl(p.title))}</h1><p>${ex(tl(p.description))}</p>` +
      `<dl>${rows.map((r) => `<dt>${ex(r[0])}</dt><dd>${ex(r[1])}</dd>`).join('')}</dl>${rich(tl(p.details))}${photos}` + foot;
  }
  if (post) {
    const n = post;
    const photos = (n.photos || []).map((ph: string, i: number) => `<img src="${ex('/' + String(ph).replace(/^\/+/, ''))}" alt="${ex(tl(n.title) + ' · ' + (i + 1))}" loading="lazy" decoding="async">`).join('');
    return header + `<main><p><a href="${secUrl('news')}">← ${ex(x.nav.news)}</a></p><h1>${ex(tl(n.title))}</h1><p><time datetime="${ex(n.date)}">${ex(n.date)}</time></p><p>${ex(tl(n.summary))}</p>${rich(tl(n.body))}${photos}` + foot;
  }
  if (svc) { // Service sheet (2026-11-26): the same facts svView() shows
    const s = svc;
    const ul = (a: string[]) => '<ul>' + a.map((v) => '<li>' + ex(v) + '</li>').join('') + '</ul>';
    const cats: string[] = s.key === 'cad' ? ['CAD', 'Mechanical'] : s.key === 'iot' ? ['IoT', 'Embedded'] : []; // SK_MAP in app.js
    const work = shown.filter((p) => cats.includes(p.category));
    return header + `<main><p><a href="${secUrl('services')}">← ${ex(x.sv.back)}</a></p><p>${ex(s.code)} · ${ex(x.sv.label)}</p><h1>${ex(tl(s.title))}</h1><p>${ex(tl(s.body))}</p>` +
      `<dl><dt>${ex(x.turnaround)}</dt><dd>${ex(s.time ? tl(s.time) : x.onRequest)}</dd></dl>` +
      `<h2>${ex(x.deliverables)}</h2>${ul(tl(s.get))}<h2>${ex(x.needs)}</h2>${ul(tl(s.need))}` +
      `<h2>${ex(x.sv.how)}</h2><ol>${x.hm.how.map((st: string[]) => `<li>${ex(st[0])} — ${ex(st[1])}</li>`).join('')}</ol>` +
      (work.length ? `<h2>${ex(x.sv.work)}</h2><ul>${work.map((p) => `<li><a href="${ex(landingOf('p', p.slug))}">${ex(tl(p.title))}</a> — ${ex(catName(p))}, ${ex(p.year)}. ${ex(tl(p.description))}</li>`).join('')}</ul>` : '') +
      `<h2>${ex(x.sv.other)}</h2><ul>${services.filter((o: any) => o !== s).map((o: any) => `<li><a href="${svcUrl(o)}">${ex(o.code)} · ${ex(tl(o.title))}</a></li>`).join('')}</ul>` + foot;
  }
  if (view === 'news') {
    const list = posts.filter((n) => !n.draft).sort((a, b) => String(b.date).localeCompare(String(a.date)));
    return header + `<main><h1>${ex(x.newsPageTitle)}</h1><p>${ex(x.newsLead)}</p><ul>${list.map((n) => `<li><a href="${ex(landingOf('n', n.slug))}">${ex(tl(n.title))}</a> (<time datetime="${ex(n.date)}">${ex(n.date)}</time>) — ${ex(tl(n.summary))}</li>`).join('')}</ul>` + foot;
  }
  const svcList = services.map((s: any) => `<li><h3><a href="${svcUrl(s)}">${ex(s.code)} · ${ex(tl(s.title))}</a></h3><p>${ex(tl(s.body))}</p><p>${ex(x.turnaround)}: ${ex(s.time ? tl(s.time) : x.onRequest)}</p></li>`).join('');
  const work = shown.map((p) => `<li><a href="${ex(landingOf('p', p.slug))}">${ex(tl(p.title))}</a> — ${ex(catName(p))}, ${ex(p.year)}. ${ex(tl(p.description))}</li>`).join('');
  const faqHtml = faqs.length ? `<h2>${ex(x.faq.title)}</h2><dl>${faqs.map((f: any) => `<dt>${ex(tl(f.q))}</dt><dd>${ex(tl(f.a))}</dd>`).join('')}</dl>` : '';
  const facts: [string, string][] = [[SL ? 'Lokacija' : 'Location', SL ? 'Škofja Loka, Slovenija' : 'Škofja Loka, Slovenia'], [SL ? 'Šola' : 'School', 'Šolski center Kranj'], ['CAD', SL ? 'SolidWorks 4 leta · CSWA · CSWA-AM' : 'SolidWorks 4 yrs · CSWA · CSWA-AM']].concat(x.heroSpecs.slice(2)); // same rows as #about
  if (sec === 'services') { // the service cards of #services: text, turnaround, both lists (no rates — Nace, 2026-11-27)
    const ul = (a: string[]) => '<ul>' + a.map((v) => '<li>' + ex(v) + '</li>').join('') + '</ul>';
    return header + `<main><h1>${ex(x.servicesPageTitle)}</h1><p>${ex(x.servicesPageLead)}</p>` +
      services.map((s: any) => `<section id="${ex(s.id)}"><h2><a href="${svcUrl(s)}">${ex(s.code)} · ${ex(tl(s.title))}</a></h2><p>${ex(tl(s.body))}</p><p>${ex(x.turnaround)}: ${ex(s.time ? tl(s.time) : x.onRequest)}</p><h3>${ex(x.deliverables)}</h3>${ul(tl(s.get))}<h3>${ex(x.needs)}</h3>${ul(tl(s.need))}</section>`).join('') + faqHtml + foot;
  }
  if (sec === 'glossary') { // Glossary NK-G (2026-11-27): every term with its definition, grouped as on #glossary
    const groups = ['files', 'print', 'mat', 'cad', 'elec'].filter((k) => GLOSSARY.some((g) => g.g === k));
    return header + `<main><h1>${ex(x.gl.title)}</h1><p>${ex(x.gl.lead)}</p>` +
      groups.map((k) => `<h2>${ex(x.gl.groups[k])}</h2><dl>${GLOSSARY.filter((g) => g.g === k).map((g) => `<dt id="gl-${ex(g.id)}">${ex(tl(g.t))}</dt><dd>${ex(tl(g.d) + glNote(g))}</dd>`).join('')}</dl>`).join('') + foot;
  }
  if (sec === 'work') return header + `<main><h1>${ex(x.workPageTitle)} · ${shown.length}</h1><p>${ex(x.workPageLead)}</p><ul>${work}</ul>` + foot;
  if (sec === 'skills') return header + `<main><h1>${ex(x.skillsPageTitle)}</h1><p>${ex(x.skillsPageLead)}</p>` +
    SKILLS.map((g: any) => `<h2>${ex(g[lang])}</h2><dl>${g.items.map((it: any) => `<dt>${ex(tl(it[0]))}</dt><dd>${ex(tl(it[1]))}</dd>`).join('')}</dl>`).join('') + foot;
  if (sec === 'about') return header + `<main><h1>${ex(x.aboutTitle)}</h1><p>${ex(x.aboutBody)}</p><h2>${ex(x.facts)}</h2><dl>${facts.map((r) => `<dt>${ex(r[0])}</dt><dd>${ex(r[1])}</dd>`).join('')}</dl>` +
    `<h2>${ex(x.processTitle)}</h2><ol>${x.process.map((st: string) => '<li>' + ex(st) + '</li>').join('')}</ol>` + foot;
  const posts2 = posts.filter((n) => !n.draft).sort((a, b) => String(b.date).localeCompare(String(a.date)));
  const newsHtml = posts2.length ? `<h2>${ex(x.newsPageTitle)}</h2><ul>${posts2.map((n) => `<li><a href="${ex(landingOf('n', n.slug))}">${ex(tl(n.title))}</a> (<time datetime="${ex(n.date)}">${ex(n.date)}</time>) — ${ex(tl(n.summary))}</li>`).join('')}</ul>` : '';
  return header +
    `<main><h1>${ex(x.heroA)} ${ex(x.heroB)}${ex(x.heroEm)}</h1><p>${ex(x.heroLead)}</p>` +
    `<h2>${ex(x.servicesPageTitle)}</h2><p>${ex(x.servicesPageLead)}</p><ul>${svcList}</ul>` +
    `<h2>${ex(x.nav.work)} · ${shown.length}</h2><ul>${work}</ul>${newsHtml}` +
    faqHtml +
    `<h2>${ex(x.nav.about)}</h2><p>${ex(x.aboutBody)}</p>` + foot;
})();
// Alt text of the link-preview image: the sheet / post title on a landing page with a photo, else the hero line.
const ogAlt = item ? tl(item.title) + ' — nacekepa.work' : sec || svc ? title : 'nacekepa.work — ' + T[lang].heroA + ' ' + T[lang].heroB + T[lang].heroEm;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="sl" href={altSl} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
    {landing && <meta name="nk-start" content={startView} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/atom+xml" title="Nace Kepa · News (EN)" href="/news.xml" hreflang="en" />
    <link rel="alternate" type="application/atom+xml" title="Nace Kepa · Novice (SL)" href="/news-sl.xml" hreflang="sl" />
    <meta name="theme-color" content="#eef0ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131517" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={post ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content={SL ? 'sl_SI' : 'en_GB'} />
    <meta property="og:locale:alternate" content={SL ? 'en_GB' : 'sl_SI'} />
    <meta property="og:url" content={pageUrl} />
    {post && <meta property="article:published_time" content={post.date} />}
    <meta property="og:image" content={ogImage} />
    {ogSized && <meta property="og:image:width" content="1200" />}
    {ogSized && <meta property="og:image:height" content="630" />}
    {ogSized && <meta property="og:image:type" content="image/png" />}
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" />
    <script is:inline set:html={prefs}></script>
    <style is:inline set:html={css}></style>
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
    {newsLd && <script is:inline type="application/ld+json" set:html={newsLd}></script>}
    {projectsLd && <script is:inline type="application/ld+json" set:html={projectsLd}></script>}
    {itemLd && <script is:inline type="application/ld+json" set:html={itemLd}></script>}
    {faqLd && <script is:inline type="application/ld+json" set:html={faqLd}></script>}
  </head>
  <body>
    <div id="app">
      <Fragment set:html={snapshot} />
      {SL
        ? <noscript><p style="padding:24px;font-family:sans-serif">Nace Kepa · Inženirski studio — CAD, 3D tisk, vgrajeni sistemi in celotni izdelki po meri v Škofji Loki. Za brskanje po strani vklopite JavaScript ali pišite na kepanace@gmail.com.</p></noscript>
        : <noscript><p style="padding:24px;font-family:sans-serif">Nace Kepa · Engineering Studio — CAD, 3D printing, embedded systems and full custom builds in Škofja Loka. Enable JavaScript to browse the site, or email kepanace@gmail.com.</p></noscript>}
    </div>
    <script is:inline set:html={script}></script>
    <script>
      // three.js (~600 KB) loads only when a project page with a 3D model is opened.
      let loading: Promise<unknown> | null = null;
      (window as any).NKViewerLoad = () => (loading ??= import('./viewer.js'));
      if (document.getElementById('viewer')) (window as any).NKViewerLoad();
    </script>
  </body>
</html>
